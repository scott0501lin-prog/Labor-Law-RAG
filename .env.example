# Copy to .env locally or set in Hugging Face Space Secrets. Never commit real keys.
ANTHROPIC_API_KEY=
MONGO_URI=
MONGO_DB_NAME=law_rag_db
CLAUDE_MODEL=claude-haiku-4-5-20251001
# Default: check official statutory text; cache successful downloads for 15 minutes.
VERIFY_OFFICIAL=true
# Optional: enable semantic vector fusion; requires requirements-research.txt and matching index.
RAG_SEMANTIC=false
EMBED_MODEL=text2vec
